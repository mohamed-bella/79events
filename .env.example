# Lead delivery through Resend. The API returns an error until all three values exist.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Shared production rate limiting. Required when Resend is enabled in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional analytics IDs are intentionally not loaded until a consent solution is selected.
