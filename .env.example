# Public business identity. Replace these placeholders before production launch.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.ma
NEXT_PUBLIC_COMPANY_NAME=79events
NEXT_PUBLIC_COMPANY_EMAIL=contact@79events.com
NEXT_PUBLIC_COMPANY_ADDRESS=Morocco
